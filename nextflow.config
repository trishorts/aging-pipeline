// aging pipeline: Nextflow configuration.
// D11 (user): record compute and memory for everything. Nextflow's trace records CPU, memory, I/O and
// wall time per process, cross-checking the per-stage provenance.json "resources" block.
def stamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())

trace {
    enabled = true
    file    = "${params.outdir ?: 'results'}/pipeline_info/trace_${stamp}.tsv"
    fields  = 'task_id,hash,name,tag,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,memory,time,attempt,workdir'
}
report   { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/report_${stamp}.html" }
timeline { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline_${stamp}.html" }

process {
    errorStrategy = 'retry'      // PRIDE stalls and transient 403s (pride 002/003)
    maxRetries    = 2
    withName: 'SEARCH_MM' { cpus = 32; memory = '64 GB' }   // placeholder until the measured numbers are in
}
